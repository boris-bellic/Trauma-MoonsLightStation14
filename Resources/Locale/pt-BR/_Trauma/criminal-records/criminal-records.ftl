criminal-records-status-brutalize = Brutalizar

criminal-records-console-brutalize-reason = Brutalizar a Razão

criminal-records-console-brutalize = {$officer} marcad(a) {$name} ({$job}) para levar uma surra por causa de: {$reason}
criminal-records-console-not-brutalize = {$officer} marked {$name} ({$job}) as sufficiently beaten.

criminal-records-status-demote = Demote

criminal-records-console-demote-reason = Razão do Demote

criminal-records-console-demote = {$officer} marcado(a) {$name} ({$job}) for demotion because of: {$reason}
criminal-records-console-not-demote = {$officer} marcado(a) {$name} ({$job}) não está mais marcado para rebaixamento.
